{
  "name": "card-captor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "tauri": "node scripts/tauri.mjs",
    "desktop": "node scripts/tauri.mjs dev",
    "desktop:build": "node scripts/tauri.mjs build",
    "desktop:rive": "node scripts/tauri.mjs dev --features character-validation -- -- --character-validation",
    "desktop:build:rive": "node scripts/tauri.mjs build --features character-validation"
  },
  "dependencies": {
    "@rive-app/webgl2-advanced": "2.51.0",
    "@tauri-apps/api": "2.12.5",
    "pixi.js": "8.23.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
